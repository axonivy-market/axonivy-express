{
  "$schema" : "https://json-schema.axonivy.com/14.0-dev/project/data-class.json",
  "simpleName" : "Data",
  "namespace" : "gawfs",
  "isBusinessCaseData" : true,
  "fields" : [ {
    "name" : "id",
    "type" : "Integer",
    "comment" : "Identifier"
  }, {
    "name" : "steps",
    "type" : "List<String>",
    "comment" : "Process Steps for ProcessChain"
  }, {
    "name" : "definedTasks",
    "type" : "List<gawfs.TaskDef>",
    "comment" : "List of Tasks for execution"
  }, {
    "name" : "processName",
    "comment" : "Name of the Process also later CaseName"
  }, {
    "name" : "processDescription",
    "comment" : "Description of the Process later CaseDescription"
  }, {
    "name" : "processType",
    "type" : "com.axonivy.utils.axonivyexpress.enums.ProcessType",
    "comment" : "Process type"
  }, {
    "name" : "wfusers",
    "type" : "List<ch.ivyteam.ivy.security.IUser>",
    "modifiers" : [ ]
  }, {
    "name" : "taskRepository",
    "type" : "com.axonivy.utils.axonivyexpress.entity.ExpressTaskDefinition",
    "modifiers" : [ ]
  }, {
    "name" : "formelementRepository",
    "type" : "com.axonivy.utils.axonivyexpress.entity.ExpressFormElement",
    "modifiers" : [ ]
  }, {
    "name" : "backFlag",
    "type" : "Boolean",
    "modifiers" : [ ]
  }, {
    "name" : "processID",
    "modifiers" : [ ]
  }, {
    "name" : "taskId",
    "type" : "Number",
    "comment" : "Task ID for Endpage",
    "modifiers" : [ ]
  }, {
    "name" : "discard",
    "type" : "Boolean",
    "modifiers" : [ ]
  }, {
    "name" : "isUseDefaultUI",
    "type" : "Boolean"
  }, {
    "name" : "processFolder",
    "comment" : "Folder to store file of this process"
  }, {
    "name" : "readyToExecute",
    "type" : "Boolean",
    "comment" : "Flag to marked whether process is ready to execute or not"
  }, {
    "name" : "editFlag",
    "type" : "Boolean"
  }, {
    "name" : "savedFlag",
    "type" : "Boolean"
  }, {
    "name" : "originalTaskId",
    "type" : "Long",
    "comment" : "This field store original task id which is trigger express adhoc WF"
  }, {
    "name" : "processCoOwners",
    "type" : "List<String>",
    "comment" : "This field store which user/role is co owener of express process, beside process creator"
  }, {
    "name" : "processCoOwnersDisplayName"
  }, {
    "name" : "processIcon"
  } ]
}